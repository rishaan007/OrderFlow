  updatedAt        DateTime                  @updatedAt

  assessment       TransactionRiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  business         Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedToUser   User?                     @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([assessmentId])
  @@map("risk_reviews")
}

model TrustRiskAuditEvent {
  id              String   @id @default(uuid())
  businessId      String?
  buyerIdentityId String?
  transactionId   String?
  assessmentId    String?
  disputeId       String?
  eventType       String
  actorType       String
  actorId         String?
  previousState   Json?
  newState        Json?
  reason          String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([buyerIdentityId, createdAt])
  @@index([transactionId])
  @@index([disputeId])
  @@index([eventType])
  @@map("trust_risk_audit_events")
}

model ProductChannelListing {
  id                String            @id @default(uuid())
  productId         String
  businessId        String
