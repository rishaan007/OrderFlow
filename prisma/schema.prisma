// -------------------------------------------------------------
// Phase 3: Cross-Platform Buyer Identity
// -------------------------------------------------------------

enum BuyerIdentityStatus {
  ACTIVE
  SUSPENDED
  MERGED
  DELETED
}

enum BuyerIdentityProvider {
  ORDERFLOW_ACCOUNT
  INSTAGRAM
  WHATSAPP
  FACEBOOK
  X
  EMAIL
  PHONE
}

enum IdentityConfidence {
  UNVERIFIED
  VERIFIED
  STRONGLY_VERIFIED
}

enum BuyerVerificationPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  SOCIAL_LINK_VERIFICATION
  IDENTITY_MERGE
}

enum BuyerIdentityEventType {
  IDENTITY_CREATED
  IDENTITY_LINKED
  IDENTITY_VERIFICATION_REQUESTED
  IDENTITY_VERIFIED
  IDENTITY_VERIFICATION_FAILED
  IDENTITY_UNLINKED
  IDENTITY_PROFILE_UPDATED
  MERGE_REQUESTED
  IDENTITY_MERGED
  MERGE_REJECTED
  ACCOUNT_CLAIMED
  CLAIM_CHALLENGE_ISSUED
  CLAIM_REJECTED
  IDENTITY_LOOKUP_FAILED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  passwordHash    String?
  supabaseAuthId  String?          @unique
  avatarUrl       String?
  systemRole      String           @default("USER")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  businessMembers BusinessMember[]
  auditLogs       AuditLog[]
  invitationsSent TeamInvitation[] @relation("InvitedByUser")
  claimedTransactions SocialTransaction[] @relation("BuyerTransactions")
  notifications   Notification[]   @relation("UserNotifications")
  buyerIdentity   BuyerIdentity?   @relation("BuyerIdentityAccount")
  assignedRiskReviews RiskReview[]

  @@map("users")
}

// Platform-level buyer identity. Deliberately separate from both `User`
// (an account credential) and `Customer` (a seller-scoped relationship).
model BuyerIdentity {
  id                    String              @id @default(uuid())
  userId                String?             @unique
  status                BuyerIdentityStatus @default(ACTIVE)
  accountState          String              @default("ACTIVE")
  displayName           String?
  avatarUrl             String?
  locale                String?
  timezone              String?
  email                 String?
  phone                 String?
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  verificationLevel     IdentityConfidence  @default(UNVERIFIED)
  privacySettings       Json?
  notificationPreferences Json?
  lastSeenAt            DateTime?
  mergedIntoId          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                User?                          @relation("BuyerIdentityAccount", fields: [userId], references: [id], onDelete: SetNull)
  mergedInto          BuyerIdentity?                 @relation("BuyerIdentityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom          BuyerIdentity[]               @relation("BuyerIdentityMerge")
  links               BuyerIdentityLink[]
  auditEvents         BuyerIdentityAuditEvent[]
  transactions        SocialTransaction[]            @relation("BuyerIdentityTransactions")
  customers           Customer[]
  claimChallenges     BuyerClaimChallenge[]
  verificationChallenges BuyerVerificationChallenge[]
  mergeRequestsSent   BuyerIdentityMergeRequest[]    @relation("MergeRequestSource")
  mergeRequestsReceived BuyerIdentityMergeRequest[]  @relation("MergeRequestTarget")
  trustSignals        TrustSignal[]
  riskAssessments     TransactionRiskAssessment[]

  @@index([status])
  @@index([mergedIntoId])
  @@index([email])
  @@index([phone])
  @@index([lastSeenAt])
  @@map("buyer_identities")
}

// A deterministic, externally-proven link between a buyer identity and a
// social platform identity, email address, phone number, or account.
model BuyerIdentityLink {
  id                  String                @id @default(uuid())
  buyerIdentityId     String
  provider            BuyerIdentityProvider
  externalIdentityId  String
  normalizedIdentifier String?
  confidence          IdentityConfidence    @default(UNVERIFIED)
  verificationMethod  String?
  verifiedAt          DateTime?
  lastVerifiedAt      DateTime?
  metadata            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  buyerIdentity BuyerIdentity @relation(fields: [buyerIdentityId], references: [id], onDelete: Cascade)

  // One external identity may belong to exactly one buyer identity.
  @@unique([provider, externalIdentityId])
  @@index([buyerIdentityId])
  @@index([provider, normalizedIdentifier])
  @@map("buyer_identity_links")
}

model BuyerVerificationChallenge {
  id               String                   @id @default(uuid())
  buyerIdentityId  String
  purpose          BuyerVerificationPurpose
  provider         BuyerIdentityProvider?
  target           String
  codeHash         String
  attempts         Int                      @default(0)
  maxAttempts      Int                      @default(5)
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime                 @default(now())

  buyerIdentity BuyerIdentity @relation(fields: [buyerIdentityId], references: [id], onDelete: Cascade)

  @@index([buyerIdentityId, purpose])
  @@index([buyerIdentityId, createdAt])
  @@index([expiresAt])
  @@map("buyer_verification_challenges")
}

// Single-use, expiring proof that the authenticated buyer controlled the
// transaction link before claiming it.
model BuyerClaimChallenge {
  id              String    @id @default(uuid())
  buyerIdentityId String
  transactionId   String
  tokenHash       String    @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  buyerIdentity BuyerIdentity    @relation(fields: [buyerIdentityId], references: [id], onDelete: Cascade)
  transaction   SocialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([buyerIdentityId, transactionId])
  @@index([expiresAt])
  @@map("buyer_claim_challenges")
}

model BuyerIdentityMergeRequest {
  id                   String    @id @default(uuid())
  sourceIdentityId     String
  targetIdentityId     String
  requestedByUserId    String?
  proofChannel         BuyerIdentityProvider?
  proofTarget          String?
  codeHash             String?
  attempts             Int       @default(0)
  maxAttempts          Int       @default(5)
  status               String    @default("PENDING")
  expiresAt            DateTime
  decidedAt            DateTime?
  createdAt            DateTime  @default(now())

  sourceIdentity BuyerIdentity @relation("MergeRequestSource", fields: [sourceIdentityId], references: [id], onDelete: Cascade)
  targetIdentity BuyerIdentity @relation("MergeRequestTarget", fields: [targetIdentityId], references: [id], onDelete: Cascade)

  @@index([sourceIdentityId, status])
  @@index([targetIdentityId, status])
  @@map("buyer_identity_merge_requests")
}

model BuyerIdentityAuditEvent {
  id              String                 @id @default(uuid())
  buyerIdentityId String
  actorType       String                 @default("SYSTEM") // BUYER | SELLER | SYSTEM
  actorUserId     String?
  eventType       BuyerIdentityEventType
  metadata        Json?
  createdAt       DateTime               @default(now())

  buyerIdentity BuyerIdentity @relation(fields: [buyerIdentityId], references: [id], onDelete: Cascade)

  @@index([buyerIdentityId, createdAt])
  @@index([eventType])
  @@map("buyer_identity_audit_events")
}

model Business {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  currency           String             @default("USD")
  timezone           String             @default("UTC")
  logoUrl            String?
  email              String?
  phone              String?
  address            String?
  plan               SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  planExpiresAt      DateTime?
  monthlyOrderLimit  Int                @default(50)
  maxMembersLimit    Int                @default(2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members        BusinessMember[]
  invitations    TeamInvitation[]
  profile        BusinessProfile?
  customers      Customer[]
  products       Product[]
  orders         Order[]
  conversations  Conversation[]
  payments       Payment[]
  shipments      Shipment[]
  automationJobs AutomationJob[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  socialTransactions SocialTransaction[]
  disputes       TransactionDispute[]
  channelListings ProductChannelListing[]
  socialConnections SocialConnection[]
  socialEvents      SocialEvent[]
  trustSignals      TrustSignal[]
  riskAssessments   TransactionRiskAssessment[]
  riskReviews       RiskReview[]

  @@map("businesses")
}

model BusinessMember {
  id         String     @id @default(uuid())
  businessId String
  userId     String
  role       MemberRole @default(OWNER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("business_members")
}

model BusinessProfile {
  id                    String   @id @default(uuid())
  businessId            String   @unique
  instagramHandle       String?
  whatsappNumber        String?
  whatsappPhoneNumberId String?
  whatsappAccessToken   String?
  whatsappVerifyToken   String?
  instagramPageId       String?
  instagramAccessToken   String?
  taxId                 String?
  bankDetails           String?
  orderPrefix           String   @default("ORD-")
  autoConfirmOrders     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model Customer {
  id              String   @id @default(uuid())
  businessId      String
  name            String
  phone           String?
  email           String?
  instagramHandle String?
  address         String?
  city            String?
  notes           String?
  tags            String[] @default([])
  totalSpent      Decimal  @default(0) @db.Decimal(12, 2)
  ordersCount     Int      @default(0)
  buyerIdentityId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders          Order[]
  conversations   Conversation[]
  payments        Payment[]
  notifications   Notification[]
  socialTransactions SocialTransaction[]
  buyerIdentity   BuyerIdentity? @relation(fields: [buyerIdentityId], references: [id], onDelete: SetNull)

  @@unique([businessId, buyerIdentityId])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([buyerIdentityId])
  @@index([businessId, email])
  @@index([businessId, phone])
  @@map("customers")
}

model Product {
  id                String           @id @default(uuid())
  businessId        String
  title             String
  sku               String?
  category          String?
  description       String?
  price             Decimal          @db.Decimal(12, 2)
  costPrice         Decimal?         @db.Decimal(12, 2)
  stockQuantity     Int              @default(0)
  lowStockThreshold Int              @default(5)
  trackInventory    Boolean          @default(true)
  status            ProductStatus    @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  orderItems        OrderItem[]
  channelListings   ProductChannelListing[]

  @@index([businessId])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  title         String
  sku           String?
  price         Decimal     @db.Decimal(12, 2)
  costPrice     Decimal?    @db.Decimal(12, 2)
  stockQuantity Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id               String        @id @default(uuid())
  businessId       String
  orderNumber      String
  customerId       String?
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  source           OrderSource   @default(MANUAL)
  currency         String        @default("USD")
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  discountType     String?       // FIXED | PERCENTAGE
  tax              Decimal       @default(0) @db.Decimal(12, 2)
  shipping         Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(12, 2)
  stockDeducted    Boolean       @default(false)
  notes            String?
  customerNotes    String?
  requiresApproval Boolean       @default(false)
  shippingAddress  String?
  conversationId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  shipments        Shipment[]
  notifications    Notification[]
  socialTransaction SocialTransaction?
  disputes         TransactionDispute[]
  trustSignals     TrustSignal[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, paymentStatus])
  @@index([customerId])
  @@index([conversationId])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  productId    String?
  variantId    String?
  title        String
  variantTitle String?
  sku          String?
  quantity     Int
  unitPrice    Decimal         @db.Decimal(12, 2)
  totalPrice   Decimal         @db.Decimal(12, 2)

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Conversation {
  id                 String              @id @default(uuid())
  businessId         String
  customerId         String?
  channel            ConversationChannel @default(MANUAL)
  status             ConversationStatus  @default(OPEN)
  externalChatId     String?
  contactIdentifier  String
  contactName        String?
  lastMessageAt      DateTime            @default(now())
  lastMessageSnippet String?
  unreadCount        Int                 @default(0)
  internalNotes      String?
  extractedOrderData Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages           Message[]
  orders             Order[]
  socialTransactions SocialTransaction[]

  @@index([businessId])
  @@index([customerId])
  @@index([channel])
  @@index([status])
  @@map("conversations")
}

model Message {
  id                String            @id @default(uuid())
  conversationId    String
  senderType        MessageSenderType @default(CUSTOMER)
  senderName        String?
  content           String
  mediaUrl          String?
  mediaType         String?
  messageType       MessageType       @default(TEXT)
  externalMessageId String?           @unique
  metadata          Json?
  createdAt         DateTime          @default(now())

  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model Payment {
  id              String              @id @default(uuid())
  businessId      String
  orderId         String
  customerId      String?
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("USD")
  method          PaymentMethod       @default(UPI)
  status          PaymentRecordStatus @default(PENDING_VERIFICATION)
  referenceNumber String?
  screenshotUrl   String?
  notes           String?
  rejectionReason String?
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("payments")
}

model Shipment {
  id               String          @id @default(uuid())
  businessId       String
  orderId          String
  carrier          DeliveryPartner @default(MANUAL)
  trackingNumber   String?
  trackingUrl      String?
  status           ShipmentStatus  @default(PENDING)
  shippingAddress  String
  city             String?
  state            String?
  postalCode       String?
  deliveryCharges  Decimal         @default(0) @db.Decimal(12, 2)
  estimatedDelivery DateTime?
  actualDelivery   DateTime?
  failureReason    String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

model AutomationJob {
  id           String            @id @default(uuid())
  businessId   String
  type         AutomationJobType
  payload      Json
  status       JobStatus         @default(PENDING)
  scheduledFor DateTime          @default(now())
  attempts     Int               @default(0)
  maxAttempts  Int               @default(3)
  lastError    String?
  processedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([scheduledFor])
  @@map("automation_jobs")
}

model Notification {
  id            String             @id @default(uuid())
  businessId    String
  orderId       String?
  customerId    String?
  transactionId String?
  userId        String?
  channel       String             // WHATSAPP | INSTAGRAM | IN_APP | EMAIL
  recipient     String
  title         String
  content       String
  status        NotificationStatus @default(QUEUED)
  readAt        DateTime?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order         Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer      Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  transaction   SocialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  user          User?              @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([orderId])
  @@index([transactionId])
  @@index([userId])
  @@index([status])
  @@index([readAt])
  @@map("notifications")
}

model TeamInvitation {
  id              String           @id @default(uuid())
  businessId      String
  email           String
  role            MemberRole       @default(STAFF)
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy       User?            @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([email])
  @@index([token])
  @@map("team_invitations")
}

model SocialTransaction {
  id                     String             @id @default(uuid())
  businessId             String
  orderId                String?            @unique
  customerId             String?
  conversationId         String?
  platform               SocialPlatform     @default(MANUAL)
  surface                SocialSurface      @default(MANUAL_ENTRY)
  status                 TransactionStatus  @default(INQUIRY)
  publicTrackingToken    String             @unique @default(uuid())
  externalUserId         String?
  externalConversationId String?
  externalListingId      String?
  externalPostId         String?
  sourceUrl              String?
  metadata               Json?
  buyerNotes             String?
  sellerNotes            String?
  buyerUserId            String?
  buyerIdentityId        String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  buyerIdentity  BuyerIdentity?             @relation("BuyerIdentityTransactions", fields: [buyerIdentityId], references: [id], onDelete: SetNull)
  claimChallenges BuyerClaimChallenge[]
  business       Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order          Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer       Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation   Conversation?              @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  buyerUser      User?                      @relation("BuyerTransactions", fields: [buyerUserId], references: [id], onDelete: SetNull)
  timelineEvents TransactionTimelineEvent[]
  evidence       TransactionEvidence[]
  disputes       TransactionDispute[]
  notifications  Notification[]
  riskAssessment TransactionRiskAssessment?
  trustSignals   TrustSignal[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([customerId])
  @@index([conversationId])
  @@index([buyerUserId])
  @@index([buyerIdentityId])
  @@index([buyerIdentityId, createdAt])
  @@index([publicTrackingToken])
  @@index([externalConversationId])
  @@index([externalUserId])
  @@map("social_transactions")
}

model TransactionTimelineEvent {
  id            String             @id @default(uuid())
  transactionId String
  eventType     String
  title         String
  description   String?
  actor         TimelineActor      @default(SYSTEM)
  visibility    TimelineVisibility @default(PUBLIC)
  metadata      Json?
  createdAt     DateTime           @default(now())

  transaction   SocialTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([transactionId, visibility])
  @@index([createdAt])
  @@map("transaction_timeline_events")
}

model TransactionEvidence {
  id                String                    @id @default(uuid())
  transactionId     String
  disputeId         String?
  evidenceType      EvidenceType
  verificationState EvidenceVerificationState @default(OBSERVED)
  source            String
  actor             TimelineActor             @default(SYSTEM)
  mediaUrl          String?
  notes             String?
  metadata          Json?
  contentHash       String?
  capturedAt        DateTime                  @default(now())
  createdAt         DateTime                  @default(now())

  transaction       SocialTransaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  dispute           TransactionDispute?       @relation(fields: [disputeId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([disputeId])
  @@index([evidenceType])
  @@map("transaction_evidence")
}

model TransactionDispute {
  id                     String                        @id @default(uuid())
  transactionId          String
  orderId                String?
  businessId             String
  reason                 String
  category               DisputeCategory               @default(OTHER)
  status                 DisputeStatus                 @default(REQUESTED)
  claimantType           String                        @default("BUYER")
  claimantId             String?
  decisionRecommendation DisputeDecisionRecommendation?
  refundAmount           Decimal?                      @db.Decimal(12, 2)
  buyerNotes             String?
  sellerResponse         String?
  resolutionNotes        String?
  resolutionReason       String?
  resolvedByUserId       String?
  escalatedAt            DateTime?
  evidenceRequestedAt    DateTime?
  evidenceUrls           String[]                      @default([])
  metadata               Json?
  resolvedAt             DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  transaction            SocialTransaction             @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  order                  Order?                        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  business               Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  trustSignals           TrustSignal[]
  evidenceRecords        TransactionEvidence[]

  @@index([businessId])
  @@index([transactionId])
  @@index([status])
  @@index([category])
  @@map("transaction_disputes")
}

model TrustSignal {
  id                  String               @id @default(uuid())
  buyerIdentityId     String?
  businessId          String?
  socialTransactionId String?
  orderId             String?
  disputeId           String?
  signalType          String
  category            TrustSignalCategory
  direction           TrustSignalDirection
  severity            TrustSignalSeverity
  scoreValue          Float?
  confidence          Float                @default(1.0)
  explanation         String
  sourceType          String
  sourceId            String?
  sampleSize          Int?
  observationWindow   String?
  observedAt          DateTime             @default(now())
  validUntil          DateTime?
  invalidatedAt       DateTime?
  invalidationReason  String?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  buyerIdentity       BuyerIdentity?       @relation(fields: [buyerIdentityId], references: [id], onDelete: Cascade)
  business            Business?            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialTransaction   SocialTransaction?   @relation(fields: [socialTransactionId], references: [id], onDelete: Cascade)
  order               Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispute             TransactionDispute?  @relation(fields: [disputeId], references: [id], onDelete: SetNull)

  @@index([buyerIdentityId, observedAt])
  @@index([businessId, observedAt])
  @@index([socialTransactionId])
  @@index([orderId])
  @@index([disputeId])
  @@index([category, direction])
  @@index([signalType])
  @@map("trust_signals")
}

model TransactionRiskAssessment {
  id                  String               @id @default(uuid())
  socialTransactionId String               @unique
  businessId          String
  buyerIdentityId     String?
  riskLevel           TransactionRiskLevel @default(LOW)
  score               Float                @default(0)
  reasons             Json
  evaluatedSignals    Json?
  modelVersion        String               @default("v1")
  assessedAt          DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  socialTransaction   SocialTransaction    @relation(fields: [socialTransactionId], references: [id], onDelete: Cascade)
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  buyerIdentity       BuyerIdentity?       @relation(fields: [buyerIdentityId], references: [id], onDelete: SetNull)
  reviews             RiskReview[]

  @@index([businessId, riskLevel])
  @@index([buyerIdentityId])
  @@index([riskLevel, assessedAt])
  @@map("transaction_risk_assessments")
}

model RiskReview {
  id               String                    @id @default(uuid())
  assessmentId     String
  businessId       String
  status           RiskReviewStatus          @default(OPEN)
  assignedToUserId String?
  decision         String?
  notes            String?
  reason           String
  reviewedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  assessment       TransactionRiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  business         Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedToUser   User?                     @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([assessmentId])
  @@map("risk_reviews")
}

model TrustRiskAuditEvent {
  id              String   @id @default(uuid())
  businessId      String?
  buyerIdentityId String?
  transactionId   String?
  assessmentId    String?
  disputeId       String?
  eventType       String
  actorType       String
  actorId         String?
  previousState   Json?
  newState        Json?
  reason          String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([buyerIdentityId, createdAt])
  @@index([transactionId])
  @@index([disputeId])
  @@index([eventType])
  @@map("trust_risk_audit_events")
}

model ProductChannelListing {
  id                String            @id @default(uuid())
  productId         String
  businessId        String
  platform          SocialPlatform
  externalListingId String?
  platformTitle     String?
  platformPrice     Decimal?          @db.Decimal(12, 2)
  syncStatus        ChannelSyncStatus @default(PENDING)
  lastSyncAt        DateTime?
  syncError         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([productId, platform])
  @@index([businessId])
  @@index([platform])
  @@map("product_channel_listings")
}

model SocialConnection {
  id                    String                 @id @default(uuid())
  businessId            String
  platform              SocialPlatform
  accountIdentifier     String
  accountName           String?
  avatarUrl             String?
  status                ConnectionStatus       @default(DISCONNECTED)
  healthStatus          ConnectionHealthStatus @default(DISCONNECTED)
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  webhookSecret         String?
  webhookVerified       Boolean                @default(false)
  capabilities          Json?
  metadata              Json?
  lastSyncAt            DateTime?
  lastWebhookAt         DateTime?
  lastError             String?
  connectedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform, accountIdentifier])
  @@index([businessId])
  @@index([platform])
  @@index([accountIdentifier])
  @@map("social_connections")
}

model SocialEvent {
  id                     String                @id @default(uuid())
  businessId             String?
  provider               SocialPlatform
  externalEventId        String
  eventType              SocialEventType       @default(MESSAGE_RECEIVED)
  externalAccountId      String?
  externalConversationId String?
  externalMessageId      String?
  externalUserId         String?
  occurredAt             DateTime              @default(now())
  processedAt            DateTime?
  status                 EventProcessingStatus @default(RECEIVED)
  errorMessage           String?
  payload                Json?
  createdAt              DateTime              @default(now())

  business               Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([businessId])
  @@index([provider])
  @@index([externalEventId])
  @@index([occurredAt])
  @@map("social_events")
}
