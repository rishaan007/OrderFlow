  IDENTITY_VERIFICATION_FAILED
  IDENTITY_UNLINKED
  IDENTITY_PROFILE_UPDATED
  MERGE_REQUESTED
  IDENTITY_MERGED
  MERGE_REJECTED
  ACCOUNT_CLAIMED
  CLAIM_CHALLENGE_ISSUED
  CLAIM_REJECTED
  IDENTITY_LOOKUP_FAILED
  IDENTITY_DEACTIVATED
  IDENTITY_EXPORTED
  PRIVACY_UPDATED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  passwordHash    String?
  supabaseAuthId  String?          @unique
  avatarUrl       String?
  systemRole      String           @default("USER")
  locale          String?          @default("en")
  timezone        String?          @default("UTC")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  businessMembers BusinessMember[]
  auditLogs       AuditLog[]
  invitationsSent TeamInvitation[] @relation("InvitedByUser")
  claimedTransactions SocialTransaction[] @relation("BuyerTransactions")
  notifications   Notification[]   @relation("UserNotifications")
  buyerIdentity   BuyerIdentity?   @relation("BuyerIdentityAccount")
  assignedRiskReviews RiskReview[]
  developerProfile Developer?

  @@map("users")
}

// Platform-level buyer identity. Deliberately separate from both `User`
// (an account credential) and `Customer` (a seller-scoped relationship).
model BuyerIdentity {
  id                    String              @id @default(uuid())
  userId                String?             @unique
  status                BuyerIdentityStatus @default(ACTIVE)
  accountState          String              @default("ACTIVE")
  displayName           String?
  avatarUrl             String?
  locale                String?
  timezone              String?
  countryCode           String?
  email                 String?
  phone                 String?
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  verificationLevel     IdentityConfidence  @default(UNVERIFIED)
  networkVisibility     PrivacyVisibility   @default(PRIVATE)
  reviewDisplayMode     ReviewDisplayMode   @default(VERIFIED_BUYER)
  privacySettings       Json?
  notificationPreferences Json?
  lastSeenAt            DateTime?
  deactivatedAt         DateTime?
  deletedAt             DateTime?
  mergedIntoId          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                User?                          @relation("BuyerIdentityAccount", fields: [userId], references: [id], onDelete: SetNull)
  mergedInto          BuyerIdentity?                 @relation("BuyerIdentityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom          BuyerIdentity[]               @relation("BuyerIdentityMerge")
  links               BuyerIdentityLink[]
  auditEvents         BuyerIdentityAuditEvent[]
  transactions        SocialTransaction[]            @relation("BuyerIdentityTransactions")
  customers           Customer[]
  claimChallenges     BuyerClaimChallenge[]
  verificationChallenges BuyerVerificationChallenge[]
  mergeRequestsSent   BuyerIdentityMergeRequest[]    @relation("MergeRequestSource")
  mergeRequestsReceived BuyerIdentityMergeRequest[]  @relation("MergeRequestTarget")
  trustSignals        TrustSignal[]
  riskAssessments     TransactionRiskAssessment[]
  returnRequests      ReturnRequest[]
  reviews             Review[]
  dataExports         DataExport[]

  @@index([status])
  @@index([networkVisibility])
  @@index([mergedIntoId])
  @@index([email])
  @@index([phone])
  @@index([lastSeenAt])
  @@map("buyer_identities")
}

// A deterministic, externally-proven link between a buyer identity and a
// social platform identity, email address, phone number, or account.
model BuyerIdentityLink {
  id                  String                @id @default(uuid())
  buyerIdentityId     String
  provider            BuyerIdentityProvider
  externalIdentityId  String
  normalizedIdentifier String?
  confidence          IdentityConfidence    @default(UNVERIFIED)
  verificationMethod  String?
  verifiedAt          DateTime?
  lastVerifiedAt      DateTime?
  metadata            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  buyerIdentity BuyerIdentity @relation(fields: [buyerIdentityId], references: [id], onDelete: Cascade)

  // One external identity may belong to exactly one buyer identity.
  @@unique([provider, externalIdentityId])
  @@index([buyerIdentityId])
  @@index([provider, normalizedIdentifier])
  @@map("buyer_identity_links")
}

model BuyerVerificationChallenge {
  id               String                   @id @default(uuid())
  buyerIdentityId  String
  purpose          BuyerVerificationPurpose
  provider         BuyerIdentityProvider?
  target           String
  codeHash         String
  attempts         Int                      @default(0)
  maxAttempts      Int                      @default(5)
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime                 @default(now())

  buyerIdentity BuyerIdentity @relation(fields: [buyerIdentityId], references: [id], onDelete: Cascade)

  @@index([buyerIdentityId, purpose])
  @@index([buyerIdentityId, createdAt])
  @@index([expiresAt])
  @@map("buyer_verification_challenges")
}

// Single-use, expiring proof that the authenticated buyer controlled the
// transaction link before claiming it.
model BuyerClaimChallenge {
  id              String    @id @default(uuid())
  buyerIdentityId String
  transactionId   String
  tokenHash       String    @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  buyerIdentity BuyerIdentity    @relation(fields: [buyerIdentityId], references: [id], onDelete: Cascade)
  transaction   SocialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([buyerIdentityId, transactionId])
  @@index([expiresAt])
  @@map("buyer_claim_challenges")
}

model BuyerIdentityMergeRequest {
  id                   String    @id @default(uuid())
  sourceIdentityId     String
  targetIdentityId     String
  requestedByUserId    String?
  proofChannel         BuyerIdentityProvider?
  proofTarget          String?
  codeHash             String?
  attempts             Int       @default(0)
  maxAttempts          Int       @default(5)
  status               String    @default("PENDING")
  expiresAt            DateTime
  decidedAt            DateTime?
  createdAt            DateTime  @default(now())

  sourceIdentity BuyerIdentity @relation("MergeRequestSource", fields: [sourceIdentityId], references: [id], onDelete: Cascade)
  targetIdentity BuyerIdentity @relation("MergeRequestTarget", fields: [targetIdentityId], references: [id], onDelete: Cascade)

  @@index([sourceIdentityId, status])
  @@index([targetIdentityId, status])
  @@map("buyer_identity_merge_requests")
}

model BuyerIdentityAuditEvent {
  id              String                 @id @default(uuid())
  buyerIdentityId String
  actorType       String                 @default("SYSTEM") // BUYER | SELLER | SYSTEM
  actorUserId     String?
  eventType       BuyerIdentityEventType
  metadata        Json?
  createdAt       DateTime               @default(now())

  buyerIdentity BuyerIdentity @relation(fields: [buyerIdentityId], references: [id], onDelete: Cascade)

  @@index([buyerIdentityId, createdAt])
  @@index([eventType])
  @@map("buyer_identity_audit_events")
}

model Business {
  id                 String                 @id @default(uuid())
  name               String
  slug               String                 @unique
  currency           String                 @default("USD")
  timezone           String                 @default("UTC")
  countryCode        String                 @default("US")
  locale             String                 @default("en")
  accountStatus      AccountLifecycleStatus @default(ACTIVE)
  isSandboxBusiness  Boolean                @default(false)
  deletedAt          DateTime?
  logoUrl            String?
  email              String?
  phone              String?
  address            String?
  plan               SubscriptionPlan       @default(FREE)
  subscriptionStatus SubscriptionStatus     @default(ACTIVE)
  planExpiresAt      DateTime?
  monthlyOrderLimit  Int                    @default(50)
  maxMembersLimit    Int                    @default(2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  members        BusinessMember[]
  invitations    TeamInvitation[]
  profile        BusinessProfile?
  customers      Customer[]
  products       Product[]
  orders         Order[]
  conversations  Conversation[]
  payments       Payment[]
  shipments      Shipment[]
  automationJobs AutomationJob[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  socialTransactions SocialTransaction[]
  disputes       TransactionDispute[]
  channelListings ProductChannelListing[]
  socialConnections SocialConnection[]
  socialEvents      SocialEvent[]
  trustSignals      TrustSignal[]
  riskAssessments   TransactionRiskAssessment[]
  riskReviews       RiskReview[]
  paymentIntents    PaymentIntent[]
  paymentAttempts   PaymentAttempt[]
  refunds           Refund[]
  returnRequests    ReturnRequest[]
  ledgerEntries     LedgerEntry[]
  paymentProviderConfigs PaymentProviderConfig[]
  providerWebhookEvents  ProviderWebhookEvent[]
  trackingEvents    TrackingEvent[]
  shippingLabels    ShippingLabel[]
  reconciliationRuns    ReconciliationRun[]
  reconciliationEntries ReconciliationEntry[]
  sellerProfile         SellerProfile?
  sellerVerifications   SellerVerification[]
  marketplaceListings   MarketplaceListing[]
  reviews               Review[]
  developerApps         DeveloperApplication[]
  integrationConnections IntegrationConnection[]
  taxRules              TaxRule[]
  dataExports           DataExport[]
  backgroundJobs        BackgroundJob[]

  @@index([accountStatus])
  @@index([countryCode])
  @@map("businesses")
}

model BusinessMember {
  id         String     @id @default(uuid())
  businessId String
  userId     String
  role       MemberRole @default(OWNER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("business_members")
}

model BusinessProfile {
  id                    String   @id @default(uuid())
  businessId            String   @unique
  instagramHandle       String?
  whatsappNumber        String?
  whatsappPhoneNumberId String?
  whatsappAccessToken   String?
  whatsappVerifyToken   String?
  instagramPageId       String?
  instagramAccessToken   String?
  taxId                 String?
  bankDetails           String?
  orderPrefix           String   @default("ORD-")
  autoConfirmOrders     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model Customer {
  id              String   @id @default(uuid())
  businessId      String
  name            String
  phone           String?
  email           String?
  instagramHandle String?
  address         String?
  city            String?
  notes           String?
  tags            String[] @default([])
  totalSpent      Decimal  @default(0) @db.Decimal(12, 2)
  ordersCount     Int      @default(0)
  buyerIdentityId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders          Order[]
  conversations   Conversation[]
  payments        Payment[]
  notifications   Notification[]
  socialTransactions SocialTransaction[]
  returnRequests  ReturnRequest[]
  buyerIdentity   BuyerIdentity? @relation(fields: [buyerIdentityId], references: [id], onDelete: SetNull)

  @@unique([businessId, buyerIdentityId])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([buyerIdentityId])
  @@index([businessId, email])
  @@index([businessId, phone])
  @@map("customers")
}

model Product {
  id                     String           @id @default(uuid())
  businessId             String
  title                  String
  sku                    String?
  category               String?
  brand                  String?
  tags                   String[]         @default([])
  description            String?
  price                  Decimal          @db.Decimal(12, 2)
  costPrice              Decimal?         @db.Decimal(12, 2)
  stockQuantity          Int              @default(0)
  lowStockThreshold      Int              @default(5)
  trackInventory         Boolean          @default(true)
  status                 ProductStatus    @default(ACTIVE)
  marketplaceDiscoverable Boolean         @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  business               Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants               ProductVariant[]
  orderItems             OrderItem[]
  channelListings        ProductChannelListing[]
  marketplaceListing     MarketplaceListing?
  reviews                Review[]

  @@index([businessId])
  @@index([marketplaceDiscoverable, status])
  @@index([category])
  @@index([brand])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  title         String
  sku           String?
  price         Decimal     @db.Decimal(12, 2)
  costPrice     Decimal?    @db.Decimal(12, 2)
  stockQuantity Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id                        String        @id @default(uuid())
  businessId                String
  orderNumber               String
  customerId                String?
  status                    OrderStatus   @default(PENDING)
  fulfillmentStatus         FulfillmentStatus?
  paymentStatus             PaymentStatus @default(PENDING)
  source                    OrderSource   @default(MANUAL)
  currency                  String        @default("USD")
  subtotal                  Decimal       @db.Decimal(12, 2)
  discount                  Decimal       @default(0) @db.Decimal(12, 2)
  discountType              String?       // FIXED | PERCENTAGE
  tax                       Decimal       @default(0) @db.Decimal(12, 2)
  shipping                  Decimal       @default(0) @db.Decimal(12, 2)
  feesMinorUnits            Int           @default(0)
  totalAmount               Decimal       @db.Decimal(12, 2)
  amountPaid                Decimal       @default(0) @db.Decimal(12, 2)
  refundedAmountMinorUnits  Int           @default(0)
  totalSnapshot             Json?
  taxBreakdown              Json?
  shippingAddressStructured Json?
  isSandbox                 Boolean       @default(false)
  stockDeducted             Boolean       @default(false)
  notes                     String?
  customerNotes             String?
  requiresApproval          Boolean       @default(false)
  shippingAddress           String?
  returnPolicy              Json?
  conversationId            String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  paymentIntents   PaymentIntent[]
  refunds          Refund[]
  returns          ReturnRequest[]
  ledgerEntries    LedgerEntry[]
  shipments        Shipment[]
  notifications    Notification[]
  socialTransaction SocialTransaction?
  disputes         TransactionDispute[]
  trustSignals     TrustSignal[]
  reviews          Review[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, paymentStatus])
  @@index([businessId, isSandbox])
  @@index([customerId])
  @@index([conversationId])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  productId    String?
  variantId    String?
  title        String
  variantTitle String?
  sku          String?
  quantity     Int
  unitPrice    Decimal         @db.Decimal(12, 2)
  totalPrice   Decimal         @db.Decimal(12, 2)

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems  ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Conversation {
  id                 String              @id @default(uuid())
  businessId         String
  customerId         String?
  channel            ConversationChannel @default(MANUAL)
  status             ConversationStatus  @default(OPEN)
  externalChatId     String?
  contactIdentifier  String
  contactName        String?
  lastMessageAt      DateTime            @default(now())
  lastMessageSnippet String?
  unreadCount        Int                 @default(0)
  internalNotes      String?
  extractedOrderData Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages           Message[]
  orders             Order[]
  socialTransactions SocialTransaction[]

  @@index([businessId])
  @@index([customerId])
  @@index([channel])
  @@index([status])
  @@map("conversations")
}

model Message {
  id                String            @id @default(uuid())
  conversationId    String
  senderType        MessageSenderType @default(CUSTOMER)
  senderName        String?
  content           String
  mediaUrl          String?
  mediaType         String?
  messageType       MessageType       @default(TEXT)
  externalMessageId String?           @unique
  metadata          Json?
