datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum OrderSource {
  MANUAL
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  X
  ONLINE
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  X
  MANUAL
  OTHER
}

enum ConversationStatus {
  OPEN
  PENDING_ORDER
  ORDER_CREATED
  RESOLVED
  ARCHIVED
}

enum MessageSenderType {
  CUSTOMER
  SELLER
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  ORDER_INQUIRY
  PAYMENT_PROOF
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum PaymentMethod {
  UPI
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentRecordStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  REFUNDED
}

enum DeliveryPartner {
  MANUAL
  SHIPROCKET
  DELHIVERY
  BLUEDART
  PORTER
  DUNZO
  FEDEX
  LOCAL_COURIER
  OTHER
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  X
  TIKTOK
  TELEGRAM
  OTHER
  MANUAL
}

enum SocialSurface {
  DM
  POST
  STORY
  REEL
  SHOP
  MARKETPLACE
  MESSENGER
  PAGE
  DIRECT_CHAT
  BUSINESS_PROFILE
  CATALOG
  X_DM
  TWEET
  MANUAL_ENTRY
  EXTERNAL_LINK
  OTHER
}

enum TransactionStatus {
  INQUIRY
  INTENT_CONFIRMED
  ORDER_CREATED
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  PROCESSING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum TimelineVisibility {
  PUBLIC
  INTERNAL_ONLY
}

enum TimelineActor {
  BUYER
  SELLER
  SYSTEM
  CARRIER
}

enum EvidenceType {
  ORIGINAL_MESSAGE
  ORDER_CONFIRMATION
  PAYMENT_PROOF
  PAYMENT_VERIFICATION
  SHIPMENT_CREATION
  CARRIER_TRACKING
  DELIVERY_CONFIRMATION
  BUYER_CONFIRMATION
  SELLER_CONFIRMATION
  RETURN_REQUEST
  REFUND_RECORD
  DISPUTE_EVIDENCE
}

enum EvidenceVerificationState {
  OBSERVED
  USER_PROVIDED
  SELLER_CONFIRMED
  BUYER_CONFIRMED
  SYSTEM_GENERATED
  REJECTED
}

enum DisputeStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURN_IN_TRANSIT
  RETURN_RECEIVED
  REFUND_PENDING
  REFUNDED
  CLOSED
}

enum ChannelSyncStatus {
  SYNCED
  PENDING
  FAILED
  NOT_SUPPORTED
  MANUAL_REQUIRED
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED_TO_ORIGIN
  CANCELLED
}

enum AutomationJobType {
  NEW_ORDER
  PAYMENT_REMINDER
  ORDER_STATUS_UPDATE
  DELIVERY_DISPATCH
  DELIVERY_DELIVERED
  LOW_STOCK_ALERT
  INVENTORY_RESTORE
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ConnectionStatus {
  CONNECTED
  CONNECTING
  REAUTH_REQUIRED
  ERROR
  DISCONNECTED
  PENDING_APPROVAL
}

enum ConnectionHealthStatus {
  HEALTHY
  DEGRADED
  AUTHENTICATION_REQUIRED
  WEBHOOK_ERROR
  RATE_LIMITED
  DISCONNECTED
}

enum SocialEventType {
  MESSAGE_RECEIVED
  MESSAGE_SENT
  CONVERSATION_CREATED
  CONVERSATION_UPDATED
  MEDIA_RECEIVED
  PRODUCT_REFERENCE
  LISTING_REFERENCE
  ORDER_EVENT
  WEBHOOK_VERIFICATION
}

enum EventProcessingStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  IGNORED
  FAILED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  passwordHash    String?
  supabaseAuthId  String?          @unique
  avatarUrl       String?
  systemRole      String           @default("USER")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  businessMembers BusinessMember[]
  auditLogs       AuditLog[]
  invitationsSent TeamInvitation[] @relation("InvitedByUser")
  claimedTransactions SocialTransaction[] @relation("BuyerTransactions")
  notifications   Notification[]   @relation("UserNotifications")

  @@map("users")
}

model Business {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  currency           String             @default("USD")
  timezone           String             @default("UTC")
  logoUrl            String?
  email              String?
  phone              String?
  address            String?
  plan               SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  planExpiresAt      DateTime?
  monthlyOrderLimit  Int                @default(50)
  maxMembersLimit    Int                @default(2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members        BusinessMember[]
  invitations    TeamInvitation[]
  profile        BusinessProfile?
  customers      Customer[]
  products       Product[]
  orders         Order[]
  conversations  Conversation[]
  payments       Payment[]
  shipments      Shipment[]
  automationJobs AutomationJob[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  socialTransactions SocialTransaction[]
  disputes       TransactionDispute[]
  channelListings ProductChannelListing[]
  socialConnections SocialConnection[]
  socialEvents      SocialEvent[]

  @@map("businesses")
}

model BusinessMember {
  id         String     @id @default(uuid())
  businessId String
  userId     String
  role       MemberRole @default(OWNER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("business_members")
}

model BusinessProfile {
  id                    String   @id @default(uuid())
  businessId            String   @unique
  instagramHandle       String?
  whatsappNumber        String?
  whatsappPhoneNumberId String?
  whatsappAccessToken   String?
  whatsappVerifyToken   String?
  instagramPageId       String?
  instagramAccessToken   String?
  taxId                 String?
  bankDetails           String?
  orderPrefix           String   @default("ORD-")
  autoConfirmOrders     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model Customer {
  id              String   @id @default(uuid())
  businessId      String
  name            String
  phone           String?
  email           String?
  instagramHandle String?
  address         String?
  city            String?
  notes           String?
  tags            String[] @default([])
  totalSpent      Decimal  @default(0) @db.Decimal(12, 2)
  ordersCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders          Order[]
  conversations   Conversation[]
  payments        Payment[]
  notifications   Notification[]
  socialTransactions SocialTransaction[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@map("customers")
}

model Product {
  id                String           @id @default(uuid())
  businessId        String
  title             String
  sku               String?
  category          String?
  description       String?
  price             Decimal          @db.Decimal(12, 2)
  costPrice         Decimal?         @db.Decimal(12, 2)
  stockQuantity     Int              @default(0)
  lowStockThreshold Int              @default(5)
  trackInventory    Boolean          @default(true)
  status            ProductStatus    @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  orderItems        OrderItem[]
  channelListings   ProductChannelListing[]

  @@index([businessId])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  title         String
  sku           String?
  price         Decimal     @db.Decimal(12, 2)
  costPrice     Decimal?    @db.Decimal(12, 2)
  stockQuantity Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id               String        @id @default(uuid())
  businessId       String
  orderNumber      String
  customerId       String?
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  source           OrderSource   @default(MANUAL)
  currency         String        @default("USD")
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  discountType     String?       // FIXED | PERCENTAGE
  tax              Decimal       @default(0) @db.Decimal(12, 2)
  shipping         Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(12, 2)
  stockDeducted    Boolean       @default(false)
  notes            String?
  customerNotes    String?
  requiresApproval Boolean       @default(false)
  shippingAddress  String?
  conversationId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  shipments        Shipment[]
  notifications    Notification[]
  socialTransaction SocialTransaction?
  disputes         TransactionDispute[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, paymentStatus])
  @@index([customerId])
  @@index([conversationId])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  productId    String?
  variantId    String?
  title        String
  variantTitle String?
  sku          String?
  quantity     Int
  unitPrice    Decimal         @db.Decimal(12, 2)
  totalPrice   Decimal         @db.Decimal(12, 2)

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Conversation {
  id                 String              @id @default(uuid())
  businessId         String
  customerId         String?
  channel            ConversationChannel @default(MANUAL)
  status             ConversationStatus  @default(OPEN)
  externalChatId     String?
  contactIdentifier  String
  contactName        String?
  lastMessageAt      DateTime            @default(now())
  lastMessageSnippet String?
  unreadCount        Int                 @default(0)
  internalNotes      String?
  extractedOrderData Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages           Message[]
  orders             Order[]
  socialTransactions SocialTransaction[]

  @@index([businessId])
  @@index([customerId])
  @@index([channel])
  @@index([status])
  @@map("conversations")
}

model Message {
  id                String            @id @default(uuid())
  conversationId    String
  senderType        MessageSenderType @default(CUSTOMER)
  senderName        String?
  content           String
  mediaUrl          String?
  mediaType         String?
  messageType       MessageType       @default(TEXT)
  externalMessageId String?           @unique
  metadata          Json?
  createdAt         DateTime          @default(now())

  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model Payment {
  id              String              @id @default(uuid())
  businessId      String
  orderId         String
  customerId      String?
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("USD")
  method          PaymentMethod       @default(UPI)
  status          PaymentRecordStatus @default(PENDING_VERIFICATION)
  referenceNumber String?
  screenshotUrl   String?
  notes           String?
  rejectionReason String?
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("payments")
}

model Shipment {
  id               String          @id @default(uuid())
  businessId       String
  orderId          String
  carrier          DeliveryPartner @default(MANUAL)
  trackingNumber   String?
  trackingUrl      String?
  status           ShipmentStatus  @default(PENDING)
  shippingAddress  String
  city             String?
  state            String?
  postalCode       String?
  deliveryCharges  Decimal         @default(0) @db.Decimal(12, 2)
  estimatedDelivery DateTime?
  actualDelivery   DateTime?
  failureReason    String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

model AutomationJob {
  id           String            @id @default(uuid())
  businessId   String
  type         AutomationJobType
  payload      Json
  status       JobStatus         @default(PENDING)
  scheduledFor DateTime          @default(now())
  attempts     Int               @default(0)
  maxAttempts  Int               @default(3)
  lastError    String?
  processedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([scheduledFor])
  @@map("automation_jobs")
}

model Notification {
  id            String             @id @default(uuid())
  businessId    String
  orderId       String?
  customerId    String?
  transactionId String?
  userId        String?
  channel       String             // WHATSAPP | INSTAGRAM | IN_APP | EMAIL
  recipient     String
  title         String
  content       String
  status        NotificationStatus @default(QUEUED)
  readAt        DateTime?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order         Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer      Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  transaction   SocialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  user          User?              @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([orderId])
  @@index([transactionId])
  @@index([userId])
  @@index([status])
  @@index([readAt])
  @@map("notifications")
}

model TeamInvitation {
  id              String           @id @default(uuid())
  businessId      String
  email           String
  role            MemberRole       @default(STAFF)
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy       User?            @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([email])
  @@index([token])
  @@map("team_invitations")
}

model SocialTransaction {
  id                     String             @id @default(uuid())
  businessId             String
  orderId                String?            @unique
  customerId             String?
  conversationId         String?
  platform               SocialPlatform     @default(MANUAL)
  surface                SocialSurface      @default(MANUAL_ENTRY)
  status                 TransactionStatus  @default(INQUIRY)
  publicTrackingToken    String             @unique @default(uuid())
  externalUserId         String?
  externalConversationId String?
  externalListingId      String?
  externalPostId         String?
  sourceUrl              String?
  metadata               Json?
  buyerNotes             String?
  sellerNotes            String?
  buyerUserId            String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  business       Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order          Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer       Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation   Conversation?              @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  buyerUser      User?                      @relation("BuyerTransactions", fields: [buyerUserId], references: [id], onDelete: SetNull)
  timelineEvents TransactionTimelineEvent[]
  evidence       TransactionEvidence[]
  disputes       TransactionDispute[]
  notifications  Notification[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([customerId])
  @@index([conversationId])
  @@index([buyerUserId])
  @@index([publicTrackingToken])
  @@index([externalConversationId])
  @@index([externalUserId])
  @@map("social_transactions")
}

model TransactionTimelineEvent {
  id            String             @id @default(uuid())
  transactionId String
  eventType     String
  title         String
  description   String?
  actor         TimelineActor      @default(SYSTEM)
  visibility    TimelineVisibility @default(PUBLIC)
  metadata      Json?
  createdAt     DateTime           @default(now())

  transaction   SocialTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([transactionId, visibility])
  @@index([createdAt])
  @@map("transaction_timeline_events")
}

model TransactionEvidence {
  id                String                    @id @default(uuid())
  transactionId     String
  evidenceType      EvidenceType
  verificationState EvidenceVerificationState @default(OBSERVED)
  source            String
  actor             TimelineActor             @default(SYSTEM)
  mediaUrl          String?
  notes             String?
  metadata          Json?
  createdAt         DateTime                  @default(now())

  transaction       SocialTransaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([evidenceType])
  @@map("transaction_evidence")
}

model TransactionDispute {
  id              String        @id @default(uuid())
  transactionId   String
  orderId         String?
  businessId      String
  reason          String
  status          DisputeStatus @default(REQUESTED)
  refundAmount    Decimal?      @db.Decimal(12, 2)
  buyerNotes      String?
  sellerResponse  String?
  resolutionNotes String?
  evidenceUrls    String[]      @default([])
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transaction     SocialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([transactionId])
  @@index([status])
  @@map("transaction_disputes")
}

model ProductChannelListing {
  id                String            @id @default(uuid())
  productId         String
  businessId        String
  platform          SocialPlatform
  externalListingId String?
  platformTitle     String?
  platformPrice     Decimal?          @db.Decimal(12, 2)
  syncStatus        ChannelSyncStatus @default(PENDING)
  lastSyncAt        DateTime?
  syncError         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([productId, platform])
  @@index([businessId])
  @@index([platform])
  @@map("product_channel_listings")
}

model SocialConnection {
  id                    String                 @id @default(uuid())
  businessId            String
  platform              SocialPlatform
  accountIdentifier     String
  accountName           String?
  avatarUrl             String?
  status                ConnectionStatus       @default(DISCONNECTED)
  healthStatus          ConnectionHealthStatus @default(DISCONNECTED)
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  webhookSecret         String?
  webhookVerified       Boolean                @default(false)
  capabilities          Json?
  metadata              Json?
  lastSyncAt            DateTime?
  lastWebhookAt         DateTime?
  lastError             String?
  connectedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform, accountIdentifier])
  @@index([businessId])
  @@index([platform])
  @@index([accountIdentifier])
  @@map("social_connections")
}

model SocialEvent {
  id                     String                @id @default(uuid())
  businessId             String?
  provider               SocialPlatform
  externalEventId        String
  eventType              SocialEventType       @default(MESSAGE_RECEIVED)
  externalAccountId      String?
  externalConversationId String?
  externalMessageId      String?
  externalUserId         String?
  occurredAt             DateTime              @default(now())
  processedAt            DateTime?
  status                 EventProcessingStatus @default(RECEIVED)
  errorMessage           String?
  payload                Json?
  createdAt              DateTime              @default(now())

  business               Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([businessId])
  @@index([provider])
  @@index([externalEventId])
  @@index([occurredAt])
  @@map("social_events")
}
