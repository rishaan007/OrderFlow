// -------------------------------------------------------------
// Phase 3: Cross-Platform Buyer Identity
// -------------------------------------------------------------

enum BuyerIdentityStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  MERGED
  DELETED
}

enum PrivacyVisibility {
  PRIVATE
  SELLER_VISIBLE
  NETWORK_VISIBLE
