model SocialEvent {
  id                     String                @id @default(uuid())
  businessId             String?
  provider               SocialPlatform
  externalEventId        String
  eventType              SocialEventType       @default(MESSAGE_RECEIVED)
  externalAccountId      String?
  externalConversationId String?
  externalMessageId      String?
  externalUserId         String?
  occurredAt             DateTime              @default(now())
  processedAt            DateTime?
  status                 EventProcessingStatus @default(RECEIVED)
  errorMessage           String?
  payload                Json?
  createdAt              DateTime              @default(now())

  business               Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([businessId])
  @@index([provider])
  @@index([externalEventId])
  @@index([occurredAt])
  @@map("social_events")
}

// =============================================================
// Phase 5: Commerce Infrastructure (Payments, Logistics, Reconciliation & Returns)
// =============================================================

enum FulfillmentStatus {
  UNFULFILLED
  ALLOCATED
  PACKED
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED_TO_ORIGIN
  CANCELLED
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  PARTIALLY_CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  MANUAL
  OTHER
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum RefundType {
  FULL_REFUND
  PARTIAL_REFUND
  CANCELLATION_REFUND
  RETURN_REFUND
  DISPUTE_REFUND
  MANUAL_REFUND
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  LABEL_CREATED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  REFUND_PENDING
  REFUNDED
  CANCELLED
}

enum ReturnReason {
  WRONG_ITEM
  DAMAGED_ITEM
  ITEM_NOT_AS_DESCRIBED
  SIZE_ISSUE
  CHANGED_MIND
  DEFECTIVE_ITEM
  MISSING_ITEM
  OTHER
}

enum LedgerEntryType {
  PAYMENT_AUTHORIZED
  PAYMENT_RECEIVED
  PAYMENT_CAPTURED
  REFUND_ISSUED
  REFUND_COMPLETED
  ADJUSTMENT
  REVERSAL
  FEE
  SHIPPING_CHARGE
  RETURN_CHARGE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum ReconciliationStatus {
  MATCHED
  MISSING_INTERNAL
  MISSING_PROVIDER
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  DUPLICATE
  UNKNOWN_PROVIDER_EVENT
  STATE_MISMATCH
}

enum ReconciliationType {
  PAYMENT
  REFUND
  SHIPMENT
}

enum ProviderHealthStatus {
  CONNECTED
  DEGRADED
  AUTH_REQUIRED
  ERROR
  DISABLED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DUPLICATE
  IGNORED
}

model PaymentIntent {
  id                  String              @id @default(uuid())
  businessId          String
  orderId             String
  socialTransactionId String?
  provider            PaymentProvider     @default(MANUAL)
  providerOrderId     String?
  status              PaymentIntentStatus @default(CREATED)
  isSandbox           Boolean             @default(false)
  amountMinorUnits    Int
  capturedMinorUnits  Int                 @default(0)
  refundedMinorUnits  Int                 @default(0)
  currency            String              @default("USD")
  idempotencyKey      String
  description         String?
  metadata            Json?
  expiresAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  socialTransaction   SocialTransaction?  @relation(fields: [socialTransactionId], references: [id], onDelete: SetNull)
  attempts            PaymentAttempt[]
  payments            Payment[]
  refunds             Refund[]
  ledgerEntries       LedgerEntry[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status])
  @@index([orderId])
  @@index([socialTransactionId])
  @@index([provider, providerOrderId])
  @@map("payment_intents")
}

model PaymentAttempt {
  id                String               @id @default(uuid())
  paymentIntentId   String
  businessId        String
  attemptNumber     Int                  @default(1)
  provider          PaymentProvider
  providerPaymentId String?
  providerOrderId   String?
  amountMinorUnits  Int
  currency          String               @default("USD")
  status            PaymentAttemptStatus @default(INITIATED)
  method            PaymentMethod?
  failureCode       String?
  failureReason     String?
  idempotencyKey    String
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  paymentIntent     PaymentIntent        @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@unique([paymentIntentId, idempotencyKey])
  @@index([paymentIntentId])
  @@index([businessId])
  @@map("payment_attempts")
}

model Refund {
  id                  String             @id @default(uuid())
  businessId          String
  orderId             String
  paymentId           String?
  paymentIntentId     String?
  socialTransactionId String?
  returnRequestId     String?
  disputeId           String?
  type                RefundType         @default(MANUAL_REFUND)
  status              RefundStatus       @default(REQUESTED)
  isSandbox           Boolean            @default(false)
  amountMinorUnits    Int
  currency            String             @default("USD")
  reason              String
  provider            PaymentProvider    @default(MANUAL)
  providerRefundId    String?
  idempotencyKey      String
  requestedByUserId   String?
  processedAt         DateTime?
  failureReason       String?
  metadata            Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment             Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentIntent       PaymentIntent?     @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  socialTransaction   SocialTransaction? @relation(fields: [socialTransactionId], references: [id], onDelete: SetNull)
  returnRequest       ReturnRequest?     @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  dispute             TransactionDispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  ledgerEntries       LedgerEntry[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status])
  @@index([orderId])
  @@index([paymentIntentId])
  @@index([returnRequestId])
  @@index([provider, providerRefundId])
  @@map("refunds")
}

model ReturnRequest {
  id                        String              @id @default(uuid())
  businessId                String
  orderId                   String
  socialTransactionId       String?
  customerId                String?
  buyerIdentityId           String?
  disputeId                 String?
  status                    ReturnStatus        @default(REQUESTED)
  reason                    ReturnReason
  buyerNotes                String?
  sellerResponse            String?
  inspectionNotes           String?
  inspectionPassed          Boolean?
  policySnapshot            Json
  eligibilityResult         Json
  requestedAmountMinorUnits Int                 @default(0)
  approvedAmountMinorUnits  Int?
  currency                  String              @default("USD")
  trackingNumber            String?
  carrier                   DeliveryPartner?
  returnLabelUrl            String?
  evidenceUrls              String[]            @default([])
  approvedAt                DateTime?
  rejectedAt                DateTime?
  receivedAt                DateTime?
  inspectedAt               DateTime?
  refundedAt                DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  business                  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order                     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  socialTransaction         SocialTransaction?  @relation(fields: [socialTransactionId], references: [id], onDelete: SetNull)
  customer                  Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  buyerIdentity             BuyerIdentity?      @relation(fields: [buyerIdentityId], references: [id], onDelete: SetNull)
  dispute                   TransactionDispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  items                     ReturnItem[]
  refunds                   Refund[]

  @@index([businessId, status])
  @@index([orderId])
  @@index([socialTransactionId])
  @@index([buyerIdentityId])
  @@map("return_requests")
}

model ReturnItem {
  id                  String        @id @default(uuid())
  returnRequestId     String
  orderItemId         String
  quantity            Int
  unitPriceMinorUnits Int
  reason              String?
  conditionNotes      String?

  returnRequest       ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem           OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("return_items")
}

// Append-only immutable financial ledger.
// Updates and deletions of historical entries are strictly disallowed in domain services;
// corrections must always be recorded as compensating entries referencing reversesEntryId.
model LedgerEntry {
  id                  String             @id @default(uuid())
  businessId          String
  orderId             String
  socialTransactionId String?
  paymentId           String?
  paymentIntentId     String?
  refundId            String?
  transactionGroupId  String
  sequenceNumber      Int                @default(1)
  account             String             @default("ORDER_RECEIVABLE")
  entryType           LedgerEntryType
  direction           LedgerDirection
  isSandbox           Boolean            @default(false)
  amountMinorUnits    Int
  currency            String             @default("USD")
  referenceType       String
  referenceId         String
  reversesEntryId     String?
  provider            PaymentProvider?
  providerEventId     String?
  idempotencyKey      String?
  description         String
  metadata            Json?
  createdAt           DateTime           @default(now())

  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  socialTransaction   SocialTransaction? @relation(fields: [socialTransactionId], references: [id], onDelete: SetNull)
  payment             Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentIntent       PaymentIntent?     @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  refund              Refund?            @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([orderId, createdAt])
  @@index([transactionGroupId])
  @@index([paymentIntentId])
  @@index([refundId])
  @@map("ledger_entries")
}

model PaymentProviderConfig {
  id                   String               @id @default(uuid())
  businessId           String
  provider             PaymentProvider
  enabled              Boolean              @default(true)
  environment          String               @default("sandbox")
  accountIdentifier    String?
  encryptedCredentials String?
  status               ProviderHealthStatus @default(CONNECTED)
  lastVerifiedAt       DateTime?
  lastError            String?
  errorCount           Int                  @default(0)
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider, environment])
  @@index([businessId])
  @@index([provider, accountIdentifier])
  @@map("payment_provider_configs")
}

model ProviderWebhookEvent {
  id                   String                  @id @default(uuid())
  domain               String                  @default("PAYMENT")
  provider             String
  providerEventId      String
  eventType            String
  businessId           String?
  signatureVerified    Boolean                 @default(false)
  occurredAt           DateTime?
  receivedAt           DateTime                @default(now())
  processedAt          DateTime?
  processingStatus     WebhookProcessingStatus @default(RECEIVED)
  error                String?
  normalizedEntityType String?
  normalizedEntityId   String?
  payload              Json
  metadata             Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  business             Business?               @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([businessId, receivedAt])
  @@index([domain, processingStatus])
  @@map("provider_webhook_events")
}

model TrackingEvent {
  id              String         @id @default(uuid())
  shipmentId      String
  businessId      String
  provider        String
  providerEventId String?
  trackingNumber  String?
  status          ShipmentStatus
  rawStatus       String?
  description     String?
  location        String?
  occurredAt      DateTime
  receivedAt      DateTime       @default(now())
  rawEventData    Json?
  createdAt       DateTime       @default(now())

  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([shipmentId, occurredAt])
  @@index([businessId])
  @@map("tracking_events")
}

model ShippingLabel {
  id             String   @id @default(uuid())
  shipmentId     String   @unique
  businessId     String
  provider       String
  trackingNumber String
  labelUrl       String?
  labelReference String?
  format         String   @default("PDF")
  metadata       Json?
  createdAt      DateTime @default(now())

  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([trackingNumber])
  @@map("shipping_labels")
}

model ReconciliationRun {
  id              String               @id @default(uuid())
  businessId      String
  type            ReconciliationType
  provider        String?
  windowStart     DateTime
  windowEnd       DateTime
  totalRecords    Int                  @default(0)
  matchedCount    Int                  @default(0)
  mismatchCount   Int                  @default(0)
  unresolvedCount Int                  @default(0)
  status          String               @default("COMPLETED")
  summary         Json?
  startedAt       DateTime             @default(now())
  completedAt     DateTime?
  createdAt       DateTime             @default(now())

  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries         ReconciliationEntry[]

  @@index([businessId, type, createdAt])
  @@map("reconciliation_runs")
}

model ReconciliationEntry {
  id                       String               @id @default(uuid())
  runId                    String
  businessId               String
  status                   ReconciliationStatus
  internalEntityType       String?
  internalEntityId         String?
  providerEntityId         String?
  expectedAmountMinorUnits Int?
  actualAmountMinorUnits   Int?
  expectedCurrency         String?
  actualCurrency           String?
  expectedState            String?
  actualState              String?
  resolved                 Boolean              @default(false)
  resolvedAt               DateTime?
  resolutionNotes          String?
  notes                    String?
  metadata                 Json?
  createdAt                DateTime             @default(now())

  run                      ReconciliationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  business                 Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([businessId, status])
  @@map("reconciliation_entries")
}


// =============================================================
// Phase 6: Network, Marketplace, Global Scale & Developer Ecosystem
// =============================================================

enum MarketplaceOptInStatus {
  NOT_DISCOVERABLE
  DISCOVERABLE
}

enum SellerVerificationTier {
  UNVERIFIED
  IDENTITY_VERIFIED
  BUSINESS_VERIFIED
  HIGH_CONFIDENCE
}

enum VerificationRequestStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AccountLifecycleStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED
}

enum ReviewModerationState {
  PUBLISHED
  UNDER_REVIEW
  HIDDEN
  REMOVED
}

enum ApiKeyType {
  PUBLIC
  PRIVATE
  SERVER
}

enum ApiEnvironment {
  SANDBOX
  LIVE
}

enum ApiKeyStatus {
  ACTIVE
  ROTATED
  REVOKED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERING
  DELIVERED
  RETRYING
  FAILED
  DISABLED
}

enum IntegrationCategory {
  PAYMENTS
  LOGISTICS
  CRM
  ACCOUNTING
  ANALYTICS
  MARKETING
  COMMUNICATION
  COMMERCE
}

enum AbuseActionType {
  FLAG
  REVIEW
  LIMIT
  SUSPEND
  APPEAL
  RESOLVE
}

enum AbuseTargetType {
  SELLER
  BUYER
  REVIEW
  LISTING
  API_APP
  WEBHOOK
}

enum TaxCalculationMode {
  EXCLUSIVE
  INCLUSIVE
}

model SellerProfile {
  id                  String                 @id @default(uuid())
  businessId          String                 @unique
  displayName         String
  tagline             String?
  about               String?
  categories          String[]               @default([])
  city                String?
  state               String?
  countryCode         String?
  logoUrl             String?
  coverImageUrl       String?
  websiteUrl          String?
  marketplaceOptIn    MarketplaceOptInStatus @default(NOT_DISCOVERABLE)
  verificationTier    SellerVerificationTier @default(UNVERIFIED)
  returnPolicySummary String?
  socialLinks         Json?
  supportedCurrencies String[]               @default([])
  supportedLocales    String[]               @default(["en"])
  accountStatus       AccountLifecycleStatus @default(ACTIVE)
  verifiedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  business            Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([marketplaceOptIn, accountStatus])
  @@index([verificationTier])
  @@index([countryCode, city])
  @@map("seller_profiles")
}

model SellerVerification {
  id                 String                    @id @default(uuid())
  businessId         String
  requestedTier      SellerVerificationTier
  status             VerificationRequestStatus @default(PENDING)
  verificationMethod String
  evidenceHash       String
  evidenceReference  String?
  reviewerNotes      String?
  verifiedBy         String?
  verifiedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("seller_verifications")
}

// Lightweight materialized discovery index backed by canonical Product + Inventory models.
model MarketplaceListing {
  id                    String                 @id @default(uuid())
  businessId            String
  productId             String                 @unique
  title                 String
  description           String?
  category              String?
  brand                 String?
  tags                  String[]               @default([])
  sku                   String?
  priceMinorUnits       Int
  currency              String                 @default("USD")
  inStock               Boolean                @default(true)
  stockQuantity         Int                    @default(0)
  discoverable          Boolean                @default(false)
  sellerVerifiedTier    SellerVerificationTier @default(UNVERIFIED)
  sellerFulfillmentRate Float                  @default(100.0)
  sellerCity            String?
  sellerCountryCode     String?
  reviewAverage         Float                  @default(0)
  reviewCount           Int                    @default(0)
  searchText            String
  viewsCount            Int                    @default(0)
  ordersCount           Int                    @default(0)
  indexedAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([discoverable, category, inStock])
  @@index([discoverable, priceMinorUnits])
  @@index([discoverable, sellerVerifiedTier])
  @@index([businessId, discoverable])
  @@index([brand])
  @@index([sellerCountryCode, sellerCity])
  @@map("marketplace_listings")
}

model NetworkReputation {
  id                String   @id @default(uuid())
  entityType        String   // SELLER | BUYER
  entityId          String
  observedFacts     Json
  derivedBadges     Json
  reviewStats       Json?
  sampleSize        Int      @default(0)
  observationWindow String   @default("180d")
  verificationLevel String   @default("UNVERIFIED")
  explanation       String
  modelVersion      String   @default("v2")
  computedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, computedAt])
  @@map("network_reputations")
}

model Review {
  id                  String                @id @default(uuid())
  businessId          String
  orderId             String
  socialTransactionId String
  buyerIdentityId     String
  productId           String?
  reviewScopeKey      String                // orderId:productId or orderId:SELLER
  rating              Int
  title               String?
  comment             String?
  authorDisplayMode   ReviewDisplayMode     @default(VERIFIED_BUYER)
  authorDisplayName   String
  moderationState     ReviewModerationState @default(PUBLISHED)
  moderationNotes     String?
  sellerResponse      String?
  sellerRespondedAt   DateTime?
  sellerResponderId   String?
  editableUntil       DateTime
  editCount           Int                   @default(0)
  editHistory         Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  socialTransaction   SocialTransaction     @relation(fields: [socialTransactionId], references: [id], onDelete: Cascade)
  buyerIdentity       BuyerIdentity         @relation(fields: [buyerIdentityId], references: [id], onDelete: Cascade)
  product             Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  reports             ReviewReport[]

  @@unique([buyerIdentityId, reviewScopeKey])
  @@index([businessId, moderationState, createdAt])
  @@index([productId, moderationState])
  @@index([orderId])
  @@map("reviews")
}

model ReviewReport {
  id              String    @id @default(uuid())
  reviewId        String
  reporterType    String    // BUYER | SELLER | SYSTEM
  reporterId      String?
  reason          String
  details         String?
  status          String    @default("OPEN")
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime  @default(now())

  review          Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
  @@map("review_reports")
}

model Developer {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  organizationName String?
  websiteUrl       String?
  contactEmail     String?
  status           AccountLifecycleStatus @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications     DeveloperApplication[]

  @@map("developers")
}

model DeveloperApplication {
  id              String                 @id @default(uuid())
  developerId     String
  businessId      String?
  name            String
  description     String?
  environment     ApiEnvironment         @default(SANDBOX)
  status          AccountLifecycleStatus @default(ACTIVE)
  allowedOrigins  String[]               @default([])
  rateLimitPerMin Int                    @default(120)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  developer       Developer              @relation(fields: [developerId], references: [id], onDelete: Cascade)
  business        Business?              @relation(fields: [businessId], references: [id], onDelete: SetNull)
  apiKeys         ApiKey[]
  webhooks        WebhookSubscription[]
  usageLogs       ApiUsage[]

  @@index([developerId])
  @@index([businessId])
  @@map("developer_applications")
}

model ApiKey {
  id            String               @id @default(uuid())
  applicationId String
  businessId    String?
  name          String
  keyType       ApiKeyType           @default(SERVER)
  environment   ApiEnvironment       @default(SANDBOX)
  keyPrefix     String
  keyHash       String               @unique
  scopes        String[]             @default([])
  status        ApiKeyStatus         @default(ACTIVE)
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  application   DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  usageLogs     ApiUsage[]

  @@index([applicationId, status])
  @@index([businessId])
  @@map("api_keys")
}

model WebhookSubscription {
  id              String               @id @default(uuid())
  applicationId   String
  businessId      String
  targetUrl       String
  description     String?
  eventTypes      String[]             @default([])
  environment     ApiEnvironment       @default(SANDBOX)
  encryptedSecret String
  status          String               @default("ACTIVE")
  failureCount    Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  application     DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([businessId, environment, status])
  @@index([applicationId])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  subscriptionId String
  businessId     String
  eventId        String
  eventType      String
  payload        Json
  signature      String
  status         WebhookDeliveryStatus @default(PENDING)
  attemptCount   Int                   @default(0)
  maxAttempts    Int                   @default(5)
  nextRetryAt    DateTime?
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  responseStatus Int?
  responseBody   String?
  errorMessage   String?
  attemptHistory Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([status, nextRetryAt])
  @@index([businessId, createdAt])
  @@map("webhook_deliveries")
}

model ApiUsage {
  id            String               @id @default(uuid())
  applicationId String
  apiKeyId      String?
  businessId    String?
  method        String
  endpoint      String
  statusCode    Int
  latencyMs     Int
  environment   ApiEnvironment       @default(SANDBOX)
  createdAt     DateTime             @default(now())

  application   DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  apiKey        ApiKey?              @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([businessId, createdAt])
  @@map("api_usage")
}

model IntegrationProvider {
  id           String                  @id @default(uuid())
  slug         String                  @unique
  name         String
  category     IntegrationCategory
  description  String
  capabilities String[]                @default([])
  authType     String                  @default("API_KEY")
  logoUrl      String?
  docsUrl      String?
  isBuiltIn    Boolean                 @default(true)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  connections  IntegrationConnection[]

  @@index([category, isActive])
  @@map("integration_providers")
}

model IntegrationConnection {
  id                   String              @id @default(uuid())
  businessId           String
  providerId           String
  status               ConnectionStatus    @default(CONNECTED)
  environment          ApiEnvironment      @default(SANDBOX)
  externalAccountId    String?
  encryptedCredentials String?
  config               Json?
  capabilities         String[]            @default([])
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider             IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  events               IntegrationEvent[]

  @@unique([businessId, providerId, environment])
  @@index([businessId, status])
  @@map("integration_connections")
}

model IntegrationEvent {
  id           String                @id @default(uuid())
  connectionId String
  businessId   String
  eventType    String
  direction    String                @default("INBOUND")
  status       String                @default("PROCESSED")
  payload      Json
  error        String?
  createdAt    DateTime              @default(now())

  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([businessId, createdAt])
  @@map("integration_events")
}

model TaxRule {
  id              String             @id @default(uuid())
  businessId      String?
  name            String
  countryCode     String
  stateCode       String?
  category        String?
  rateBasisPoints Int
  mode            TaxCalculationMode @default(EXCLUSIVE)
  isActive        Boolean            @default(true)
  priority        Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  business        Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  components      TaxComponent[]

  @@index([businessId, countryCode, isActive])
  @@index([countryCode, stateCode, category])
  @@map("tax_rules")
}

model TaxComponent {
  id              String   @id @default(uuid())
  taxRuleId       String
  name            String
  rateBasisPoints Int
  createdAt       DateTime @default(now())

  taxRule         TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  @@index([taxRuleId])
  @@map("tax_components")
}

model DataExport {
  id              String         @id @default(uuid())
  requesterType   String         // BUYER | SELLER
  requesterId     String
  buyerIdentityId String?
  businessId      String?
  exportType      String
  format          String         @default("JSON")
  status          String         @default("COMPLETED")
  recordCount     Int            @default(0)
  checksum        String?
  payload         Json?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())

  buyerIdentity   BuyerIdentity? @relation(fields: [buyerIdentityId], references: [id], onDelete: SetNull)
  business        Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([buyerIdentityId, createdAt])
  @@index([businessId, createdAt])
  @@map("data_exports")
}

model BackgroundJob {
  id             String    @id @default(uuid())
  businessId     String?
  jobType        String
  idempotencyKey String?   @unique
  status         JobStatus @default(PENDING)
  payload        Json
  result         Json?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  nextRunAt      DateTime  @default(now())
  lastError      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business       Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([businessId, jobType])
  @@map("background_jobs")
}

model PlatformAbuseCase {
  id              String           @id @default(uuid())
  targetType      AbuseTargetType
  targetId        String
  businessId      String?
  buyerIdentityId String?
  reason          String
  category        String
  severity        String           @default("MEDIUM")
  status          String           @default("OPEN")
  actionTaken     AbuseActionType?
  evidence        Json?
  auditTrail      Json?
  appealNotes     String?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@map("platform_abuse_cases")
}

model NetworkRateLimitEntry {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("network_rate_limits")
}
