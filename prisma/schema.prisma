datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum OrderSource {
  MANUAL
  WHATSAPP
  INSTAGRAM
  ONLINE
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
  MANUAL
}

enum ConversationStatus {
  OPEN
  PENDING_ORDER
  ORDER_CREATED
  RESOLVED
  ARCHIVED
}

enum MessageSenderType {
  CUSTOMER
  SELLER
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  ORDER_INQUIRY
  PAYMENT_PROOF
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum PaymentMethod {
  UPI
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentRecordStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  REFUNDED
}

enum DeliveryPartner {
  MANUAL
  SHIPROCKET
  DELHIVERY
  BLUEDART
  PORTER
  DUNZO
  FEDEX
  LOCAL_COURIER
  OTHER
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED_TO_ORIGIN
  CANCELLED
}

enum AutomationJobType {
  NEW_ORDER
  PAYMENT_REMINDER
  ORDER_STATUS_UPDATE
  DELIVERY_DISPATCH
  DELIVERY_DELIVERED
  LOW_STOCK_ALERT
  INVENTORY_RESTORE
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  passwordHash    String?
  supabaseAuthId  String?          @unique
  avatarUrl       String?
  systemRole      String           @default("USER")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  businessMembers BusinessMember[]
  auditLogs       AuditLog[]
  invitationsSent TeamInvitation[] @relation("InvitedByUser")

  @@map("users")
}

model Business {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  currency           String             @default("USD")
  timezone           String             @default("UTC")
  logoUrl            String?
  email              String?
  phone              String?
  address            String?
  plan               SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  planExpiresAt      DateTime?
  monthlyOrderLimit  Int                @default(50)
  maxMembersLimit    Int                @default(2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members        BusinessMember[]
  invitations    TeamInvitation[]
  profile        BusinessProfile?
  customers      Customer[]
  products       Product[]
  orders         Order[]
  conversations  Conversation[]
  payments       Payment[]
  shipments      Shipment[]
  automationJobs AutomationJob[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@map("businesses")
}

model BusinessMember {
  id         String     @id @default(uuid())
  businessId String
  userId     String
  role       MemberRole @default(OWNER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("business_members")
}

model BusinessProfile {
  id                    String   @id @default(uuid())
  businessId            String   @unique
  instagramHandle       String?
  whatsappNumber        String?
  whatsappPhoneNumberId String?
  whatsappAccessToken   String?
  whatsappVerifyToken   String?
  instagramPageId       String?
  instagramAccessToken   String?
  taxId                 String?
  bankDetails           String?
  orderPrefix           String   @default("ORD-")
  autoConfirmOrders     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model Customer {
  id              String   @id @default(uuid())
  businessId      String
  name            String
  phone           String?
  email           String?
  instagramHandle String?
  address         String?
  city            String?
  notes           String?
  tags            String[] @default([])
  totalSpent      Decimal  @default(0) @db.Decimal(12, 2)
  ordersCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders          Order[]
  conversations   Conversation[]
  payments        Payment[]
  notifications   Notification[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@map("customers")
}

model Product {
  id                String           @id @default(uuid())
  businessId        String
  title             String
  sku               String?
  category          String?
  description       String?
  price             Decimal          @db.Decimal(12, 2)
  costPrice         Decimal?         @db.Decimal(12, 2)
  stockQuantity     Int              @default(0)
  lowStockThreshold Int              @default(5)
  trackInventory    Boolean          @default(true)
  status            ProductStatus    @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  orderItems        OrderItem[]

  @@index([businessId])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  title         String
  sku           String?
  price         Decimal     @db.Decimal(12, 2)
  costPrice     Decimal?    @db.Decimal(12, 2)
  stockQuantity Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id               String        @id @default(uuid())
  businessId       String
  orderNumber      String
  customerId       String?
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  source           OrderSource   @default(MANUAL)
  currency         String        @default("USD")
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  discountType     String?       // FIXED | PERCENTAGE
  tax              Decimal       @default(0) @db.Decimal(12, 2)
  shipping         Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(12, 2)
  stockDeducted    Boolean       @default(false)
  notes            String?
  customerNotes    String?
  requiresApproval Boolean       @default(false)
  shippingAddress  String?
  conversationId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  shipments        Shipment[]
  notifications    Notification[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, paymentStatus])
  @@index([customerId])
  @@index([conversationId])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  productId    String?
  variantId    String?
  title        String
  variantTitle String?
  sku          String?
  quantity     Int
  unitPrice    Decimal         @db.Decimal(12, 2)
  totalPrice   Decimal         @db.Decimal(12, 2)

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Conversation {
  id                 String              @id @default(uuid())
  businessId         String
  customerId         String?
  channel            ConversationChannel @default(MANUAL)
  status             ConversationStatus  @default(OPEN)
  externalChatId     String?
  contactIdentifier  String
  contactName        String?
  lastMessageAt      DateTime            @default(now())
  lastMessageSnippet String?
  unreadCount        Int                 @default(0)
  internalNotes      String?
  extractedOrderData Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages           Message[]
  orders             Order[]

  @@index([businessId])
  @@index([customerId])
  @@index([channel])
  @@index([status])
  @@map("conversations")
}

model Message {
  id                String            @id @default(uuid())
  conversationId    String
  senderType        MessageSenderType @default(CUSTOMER)
  senderName        String?
  content           String
  mediaUrl          String?
  mediaType         String?
  messageType       MessageType       @default(TEXT)
  externalMessageId String?           @unique
  metadata          Json?
  createdAt         DateTime          @default(now())

  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model Payment {
  id              String              @id @default(uuid())
  businessId      String
  orderId         String
  customerId      String?
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("USD")
  method          PaymentMethod       @default(UPI)
  status          PaymentRecordStatus @default(PENDING_VERIFICATION)
  referenceNumber String?
  screenshotUrl   String?
  notes           String?
  rejectionReason String?
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("payments")
}

model Shipment {
  id               String          @id @default(uuid())
  businessId       String
  orderId          String
  carrier          DeliveryPartner @default(MANUAL)
  trackingNumber   String?
  trackingUrl      String?
  status           ShipmentStatus  @default(PENDING)
  shippingAddress  String
  city             String?
  state            String?
  postalCode       String?
  deliveryCharges  Decimal         @default(0) @db.Decimal(12, 2)
  estimatedDelivery DateTime?
  actualDelivery   DateTime?
  failureReason    String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

model AutomationJob {
  id           String            @id @default(uuid())
  businessId   String
  type         AutomationJobType
  payload      Json
  status       JobStatus         @default(PENDING)
  scheduledFor DateTime          @default(now())
  attempts     Int               @default(0)
  maxAttempts  Int               @default(3)
  lastError    String?
  processedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([scheduledFor])
  @@map("automation_jobs")
}

model Notification {
  id         String             @id @default(uuid())
  businessId String
  orderId    String?
  customerId String?
  channel    String             // WHATSAPP | INSTAGRAM | IN_APP | EMAIL
  recipient  String
  title      String
  content    String
  status     NotificationStatus @default(QUEUED)
  sentAt     DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order      Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([orderId])
  @@index([status])
  @@map("notifications")
}

model TeamInvitation {
  id              String           @id @default(uuid())
  businessId      String
  email           String
  role            MemberRole       @default(STAFF)
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy       User?            @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([email])
  @@index([token])
  @@map("team_invitations")
}
