}

model TransactionRiskAssessment {
  id                  String               @id @default(uuid())
  socialTransactionId String               @unique
  businessId          String
  buyerIdentityId     String?
  riskLevel           TransactionRiskLevel @default(LOW)
  score               Float                @default(0)
  reasons             Json
  evaluatedSignals    Json?
  modelVersion        String               @default("v1")
  assessedAt          DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  socialTransaction   SocialTransaction    @relation(fields: [socialTransactionId], references: [id], onDelete: Cascade)
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  buyerIdentity       BuyerIdentity?       @relation(fields: [buyerIdentityId], references: [id], onDelete: SetNull)
  reviews             RiskReview[]

  @@index([businessId, riskLevel])
  @@index([buyerIdentityId])
  @@index([riskLevel, assessedAt])
  @@map("transaction_risk_assessments")
}

model RiskReview {
