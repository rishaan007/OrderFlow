  contentHash       String?
  capturedAt        DateTime                  @default(now())
  createdAt         DateTime                  @default(now())

  transaction       SocialTransaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  dispute           TransactionDispute?       @relation(fields: [disputeId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([disputeId])
  @@index([evidenceType])
  @@map("transaction_evidence")
}

model TransactionDispute {
  id                     String                        @id @default(uuid())
  transactionId          String
  orderId                String?
  businessId             String
  reason                 String
  category               DisputeCategory               @default(OTHER)
  status                 DisputeStatus                 @default(REQUESTED)
  claimantType           String                        @default("BUYER")
  claimantId             String?
