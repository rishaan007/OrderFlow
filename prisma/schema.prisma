}

enum ReviewDisplayMode {
  VERIFIED_BUYER
  NAME_INITIAL
  ANONYMOUS
}

enum BuyerIdentityProvider {
  ORDERFLOW_ACCOUNT
  INSTAGRAM
  WHATSAPP
  FACEBOOK
  X
  EMAIL
  PHONE
}

