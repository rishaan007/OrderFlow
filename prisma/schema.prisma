  transaction   SocialTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([transactionId, visibility])
  @@index([createdAt])
  @@map("transaction_timeline_events")
}

model TransactionEvidence {
  id                String                    @id @default(uuid())
  transactionId     String
  disputeId         String?
