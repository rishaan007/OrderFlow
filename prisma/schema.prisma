  evidenceRecords        TransactionEvidence[]
  refunds                Refund[]
  returns                ReturnRequest[]

  @@index([businessId])
  @@index([transactionId])
  @@index([status])
  @@index([category])
  @@map("transaction_disputes")
}

model TrustSignal {
  id                  String               @id @default(uuid())
  buyerIdentityId     String?
  businessId          String?
  socialTransactionId String?
  orderId             String?
  disputeId           String?
  signalType          String
  category            TrustSignalCategory
  direction           TrustSignalDirection
  severity            TrustSignalSeverity
  scoreValue          Float?
  confidence          Float                @default(1.0)
  explanation         String
  sourceType          String
  sourceId            String?
  sampleSize          Int?
  observationWindow   String?
  observedAt          DateTime             @default(now())
  validUntil          DateTime?
  invalidatedAt       DateTime?
