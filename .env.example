# OrderFlow Environment Configuration

# Database
# Local PostgreSQL or Cloud Database (Neon / Supabase / RDS)
DATABASE_URL="postgresql://postgres@localhost:5432/orderflow?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Security & Sessions
JWT_SECRET="orderflow-dev-secret-key-change-in-production-2025"

# Supabase Authentication (Optional if using local database auth adapter)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App Environment
NODE_ENV="development"
